# LINE Messaging API
LINE_CHANNEL_ACCESS_TOKEN=your_channel_access_token_here
LINE_CHANNEL_SECRET=your_channel_secret_here

# 通知先のLINEユーザーID（複数の場合はカンマ区切り）
# LINEのユーザーIDは "U" から始まる32文字の文字列
# 取得方法: Webhookで最初にメッセージを送ると event.source.user_id で確認できる
LINE_USER_IDS=Uxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# リマインド設定
RE_REMIND_HOURS=12      # 再リマインドの間隔（時間）
REMIND_DOW=mon          # 毎週の初回リマインド曜日 (mon/tue/wed/thu/fri/sat/sun)
REMIND_HOUR=9           # 初回リマインド時刻（時）
REMIND_MIN=0            # 初回リマインド時刻（分）

# サーバー設定
PORT=5000
